{
  "name": "@khglobal/dsh-universe",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN ../LICENSE",
  "description": "DSH Universe: AI agent data visualization. Your agents' activity as a live pixel city; sessions are buildings, agents are the people.",
  "type": "module",
  "exports": {
    ".": { "default": "./dist/index.js" },
    "./client": { "default": "./dist/client.browser.js" },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": ["dist", "cordis.patch.yml", "icon.svg", "locale/*.json", "README.md", "CHANGELOG.md"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p ../tsconfig.json --noEmit",
    "test": "node --test \"tests/*.test.ts\""
  },
  "engines": { "dsh": ">=0.2.2-rc.2" },
  "peerDependencies": { "@deepseek-ai/cordis": "4.1.0", "react": "^18.2.0 || ^19.2.4" },
  "peerDependenciesMeta": { "@deepseek-ai/cordis": { "optional": true }, "react": { "optional": true } },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-connection", "@deepseek-ai/dsh-client-locale"]
    }
  },
  "icon": "./icon.svg"
}

{
  "name": "@khglobal/dsh-universe",
  "version": "0.0.0",
  "description": "Your DeepSeek Harness day as a small pixel city: sessions are buildings, agents are the people. See what is running, what is waiting for you and what got done today. Reads metadata only; nothing leaves your device.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "author": "KH",
  "icon": "./icon.svg",
  "homepage": "https://www.npmjs.com/package/@khglobal/dsh-universe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khglobal/dsh-universe.git"
  },
  "bugs": {
    "url": "https://github.com/khglobal/dsh-universe/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dashboard",
    "pixel-art",
    "visualization"
  ],
  "exports": {
    ".": { "default": "./dist/index.js" },
    "./client": { "default": "./dist/client.browser.js" },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "dist/index.js",
    "dist/client.browser.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/en.json",
    "locale/zh.json",
    "screenshots",
    "screenshots.json",
    "README.md",
    "LICENSE"
  ],
  "engines": { "dsh": ">=0.2.2-rc.2" },
  "peerDependencies": { "@deepseek-ai/cordis": "4.1.0", "react": "^18.2.0 || ^19.2.4" },
  "peerDependenciesMeta": { "@deepseek-ai/cordis": { "optional": true }, "react": { "optional": true } },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-connection", "@deepseek-ai/dsh-client-locale"]
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
